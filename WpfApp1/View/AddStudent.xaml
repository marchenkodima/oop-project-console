<UserControl x:Class="WpfApp1.View.AddStudent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:WpfApp1.View"
    mc:Ignorable="d" Height="213" Width="130">
    <Grid Background="White">
        <Label Content="Username" Margin="10,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Width="63" />
        <TextBox Text="{Binding Username}" Width="108" Margin="10,28,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Label Content="Password" Margin="12,46,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Width="60" />
        <TextBox Text="{Binding Password}" Width="108" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,72,0,0" />
        <Label Content="Full name" Margin="12,90,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Width="61" />
        <TextBox Text="{Binding FullName}" Width="108" Margin="10,116,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Label Content="Faculty" Margin="10,134,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Width="47" />
        <TextBox Text="{Binding Faculty}" Width="108" Margin="10,160,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Button Command="{Binding AddStudentCommand}" Content="Add Student" Width="108" Height="20" Margin="10,183,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
    </Grid>
</UserControl>
