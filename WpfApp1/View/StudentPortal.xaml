<UserControl x:Class="WpfApp1.View.StudentPortal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1.View"
             mc:Ignorable="d" 
             d:DesignHeight="262.8" d:DesignWidth="360.8">
    <Grid>
        <ListView ItemsSource="{Binding StudentChats}" SelectedItem="{Binding SelectedChat}" Margin="120,96,0,0" Height="129" VerticalAlignment="Top" HorizontalAlignment="Left" Width="121">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Chat name" DisplayMemberBinding="{Binding Name}" />
                </GridView>
            </ListView.View>
        </ListView>
        <TextBox Text="{Binding Username}" HorizontalAlignment="Left" Margin="0,60,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox Text="{Binding Password}" HorizontalAlignment="Left" Margin="0,104,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button Command="{Binding SignInCommand}" Content="Sign in" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Margin="0,141,0,0"/>
        <ListView ItemsSource="{Binding ChatMessages}" Margin="241,96,0,0" HorizontalAlignment="Left" Width="119" Height="129" VerticalAlignment="Top">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" />
                </GridView>
            </ListView.View>
        </ListView>
        <TextBox Text="{Binding Message}" HorizontalAlignment="Left" Margin="241,225,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="119"/>
        <Button Command="{Binding SendMessageCommand}" Content="Send" HorizontalAlignment="Left" Margin="241,243,0,0" VerticalAlignment="Top" Width="119"/>
        <Label Content="Username" HorizontalAlignment="Left" Margin="0,34,0,0" VerticalAlignment="Top"/>
        <Label Content="Password" HorizontalAlignment="Left" Margin="0,78,0,0" VerticalAlignment="Top"/>

        <ListView ItemsSource="{Binding StudentCourses}" SelectedItem="{Binding SelectedCourse}" Width="121" Height="96" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="120,0,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Course name" DisplayMemberBinding="{Binding Name}" />
                </GridView>
            </ListView.View>
        </ListView>
        <Button Command="{Binding GetTaskCommand}" Content="Get task" HorizontalAlignment="Left" Margin="241,2,0,0" VerticalAlignment="Top" Width="120"/>
        <Button Command="{Binding SubmitTaskCommand}" Content="Submit task" HorizontalAlignment="Left" Margin="240,40,0,0" VerticalAlignment="Top" Width="121"/>
        <TextBox Text="{Binding TaskAnswer}" HorizontalAlignment="Left" Margin="241,22,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
    </Grid>
</UserControl>
