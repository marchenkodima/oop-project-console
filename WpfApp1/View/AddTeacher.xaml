<UserControl x:Class="WpfApp1.View.AddTeacher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1.View"
             mc:Ignorable="d" 
             d:DesignWidth="130.044" Height="173">
    <Grid Background="White">
        <Label Content="Username" Margin="10,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Width="63" />
        <TextBox Text="{Binding Username}" Width="108" Margin="10,28,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Label Content="Password" Margin="12,46,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Width="60" />
        <TextBox Text="{Binding Password}" Width="108" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,72,0,0" />
        <Label Content="Full name" Margin="12,90,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Width="61" />
        <TextBox Text="{Binding FullName}" Width="108" Margin="10,116,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Button Command="{Binding AddTeacherCommand}" Content="Add Teacher" Margin="10,139,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="108" />
    </Grid>
</UserControl>
