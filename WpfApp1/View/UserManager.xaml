<UserControl x:Class="WpfApp1.View.UserManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:WpfApp1.View"
    mc:Ignorable="d" 
    d:DesignHeight="221.929" d:DesignWidth="412.8">
    <Grid>
        <local:AddStudent Margin="172,0,0,0" HorizontalAlignment="Left" Height="222" VerticalAlignment="Top" Width="121" />
        <local:AddTeacher Margin="293,-1,0,0" Height="223" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120" />
        <ListView ItemsSource="{Binding Users}" Height="222" VerticalAlignment="Top" HorizontalAlignment="Left" Width="172">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Username}" Header="Username"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
